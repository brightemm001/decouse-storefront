# Local SQLite database. Set DATABASE_PATH to a mounted persistent volume in deployment.
DATABASE_PATH=./data/decouse.sqlite

# One-time first-admin account promotion. The account must also verify its email.
ADMIN_EMAIL=owner@example.com
# Optional base32 TOTP secret for every administrator account.
ADMIN_TOTP_SECRET=

# Product image uploads: use a persistent volume locally; replace with S3 or Cloudinary for production.
UPLOAD_DIR=./data/uploads

# Email verification and password resets. In production configure a verified sender domain.
RESEND_API_KEY=
MAIL_FROM=Decouse <accounts@example.com>

# Payment provider credentials are intentionally not consumed by the preview checkout.
# Configure and implement provider initiation plus server-side webhooks before enabling live payments.
PAYSTACK_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Cloudflare WAF / Turnstile are optional deployment protections; no CAPTCHA widget is loaded by default.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
